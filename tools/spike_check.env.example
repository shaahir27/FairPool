# Copy to .env.spike (it is git-ignored; never commit it). Leave a line empty to skip what needs it.
# ---- PayPal Sandbox (S1, S2, S4-S7, S10, S12, S13, core)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SINGLE_SELLER_EMAIL=
SECOND_SELLER_EMAIL=
PAYPAL_LOGIN_REDIRECT_URI=
# ---- S5 webhooks: public https URL on port 443 that tunnels to this machine's WEBHOOK_LISTEN_PORT
WEBHOOK_PUBLIC_URL=
WEBHOOK_LISTEN_PORT=8787
# ---- S6 drand and buyers
S6_BUYER_COUNT=6
# DRAND_BASE_URL=https://api.drand.sh
# ---- S8 Elastic
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# ELASTIC_INFERENCE_ID=
# ---- S9 Zapier MCP (connection token from the MCP server's Connect page)
ZAPIER_MCP_TOKEN=
# FAIRPOOL_AGENT_API_URL=
# ZAPIER_TOOL_LIST_POOLS=
# ZAPIER_TOOL_JOIN=
# ZAPIER_TOOL_LIST_ENTRIES=
# ZAPIER_TOOL_WITHDRAW=
# ZAPIER_LIST_POOLS_ARGS_JSON=
# ZAPIER_JOIN_ARGS_JSON=
# ZAPIER_LIST_ENTRIES_ARGS_JSON=
# ZAPIER_WITHDRAW_ARGS_JSON=
# ---- S11 APIMatic (the OpenAPI file comes from task T01B01)
OPENAPI_JSON_PATH=
# FAIRPOOL_API_URL=http://localhost:8000
# ---- S13
S13_LISTEN_PORT=8788
# S13_PUBLIC_URL=            # https tunnel to S13_LISTEN_PORT; needed to test client_token (localhost gives invalid_domain)
# S1_TRY_ATTRIBUTES_SCOPE=1  # optional: also retry the account-attributes scope (rejected on Oct 28)
# S10_LOCAL_CALL=0           # skip the local MCP get_order call
