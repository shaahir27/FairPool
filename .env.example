# FairPool environment template. Names and safe defaults only; never put real secrets here.
# S-marked variables are secrets: fill them in your local .env (git-ignored) or the host dashboard.
# Required values are intentionally empty; Settings fails with a clear message until they are set.

APP_ENV=local
DATABASE_URL= # S
SECRET_KEY= # S
HMAC_KEY= # S
RECEIPT_SIGNING_KEY= # S
ADDRESS_ENCRYPTION_KEY= # S
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET= # S
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CHECKOUT_BASE=https://www.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_LOGIN_ENABLED=false
PAYPAL_LOGIN_REDIRECT_URI=
PAYMENT_ROUTER=single_seller
PAYMENT_MODE=vault_charge
BID_PRICING_MODE=flat_delivered
VAULT_TOKEN_KEY= # S
VAULT_CONSENT_VERSION=v1
VAULT_CHARGE_CONCURRENCY=5
AUTHORIZE_USE_REQUEST_ID=true
PAYPAL_PAYLOAD_LEVEL=0
PAYPAL_APPROVAL_UI=sdk_popup
PAYPAL_SDK_AUTH=client_id
SHIPMENT_TRACKING_ENABLED=true
PAYPAL_MCP_VERIFICATION=paypal_read_subset
SINGLE_SELLER_EMAIL=
SINGLE_SELLER_MERCHANT_ID=
ALLOWED_PAYER_COUNTRIES=US
PLATFORM_FEE_ENABLED=false
DEDUPE_MODE=two_keys
REQUIRE_PAYPAL_LINK=false
WEBHOOKS_ENABLED=false
MOCK_TOGGLES_ENABLED=false
SEARCH_BACKEND=postgres
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY= # S
ELASTIC_INFERENCE_ID=
ELASTIC_INDEX_PREFIX=fairpool
SIMILARITY_CHECK_ENABLED=true
MCP_ENABLED=true
MERCHANT_API_ENABLED=true
ZAPIER_BRIDGE=off
AI_ENABLED=true
ANTHROPIC_API_KEY= # S
AI_MODEL_PARSE=claude-sonnet-5-5
AI_MODEL_SIM=claude-haiku-5-5
BEACON_MODE=demo
DRAND_BASE_URL=
DRAND_CHAIN_HASH=
TIMING_PROFILE=demo
CAPTURE_BUFFER=0
CAPTURE_CONCURRENCY=5
RECONCILER_INTERVAL_S=60
WORKER_CONCURRENCY=4
RATE_LIMIT_ENABLED=true

# Compose-only Postgres settings, not read by the app.
POSTGRES_USER=fairpool
POSTGRES_DB=fairpool
POSTGRES_PASSWORD=
