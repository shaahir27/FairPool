FROM node:20-slim AS web

WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
# VITE_API_BASE_URL is deliberately not set: the built client then calls this same
# origin, which is what makes the session cookie first-party.
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PYTHONPATH=/app/backend/src

WORKDIR /app

RUN groupadd --system fairpool \
    && useradd --system --gid fairpool --no-create-home fairpool

COPY backend/requirements.lock ./backend/requirements.lock
COPY backend/pyproject.toml ./backend/pyproject.toml
COPY backend/src ./backend/src
COPY backend/migrations ./backend/migrations

RUN pip install --require-hashes --retries 10 --timeout 120 -r backend/requirements.lock

# The SPA is served from this origin (see api/app.py WEB_DIR).
COPY --from=web /web/dist /app/web

USER fairpool

# Render injects PORT (10000 on its web services) and its port scan trusts this
# declaration, so the default here must match what Render assigns. Compose sets
# PORT=8000 explicitly instead of relying on this default.
EXPOSE 10000

# --no-access-log: uvicorn's access line echoes the full request target, query string
# included, so an OAuth callback's code/state or a vault return's token would reach the
# container log. Our own structured logs carry the request and stay redacted (M3);
# fairpool.logging also puts the redaction filter on uvicorn.error regardless.
# --forwarded-allow-ips: only the reverse proxy may set X-Forwarded-*, and only it can
# reach the socket. A loopback default means a direct connection cannot spoof its own
# scheme or address; Render overrides it with FORWARDED_ALLOW_IPS=* because its proxy
# arrives from an address that is not ours to pin.
CMD ["sh", "-c", "uvicorn fairpool.main:app --host 0.0.0.0 --port ${PORT:-10000} --no-access-log --forwarded-allow-ips ${FORWARDED_ALLOW_IPS:-127.0.0.1}"]
