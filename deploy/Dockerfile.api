FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PYTHONPATH=/app/backend/src

WORKDIR /app

RUN groupadd --system fairpool \
    && useradd --system --gid fairpool --no-create-home fairpool

COPY backend/requirements.lock ./backend/requirements.lock
COPY backend/pyproject.toml ./backend/pyproject.toml
COPY backend/src ./backend/src
COPY backend/migrations ./backend/migrations

RUN pip install --require-hashes --retries 10 --timeout 120 -r backend/requirements.lock

USER fairpool

EXPOSE 8000

CMD ["uvicorn", "fairpool.main:app", "--host", "0.0.0.0", "--port", "8000"]
